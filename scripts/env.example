# ClkLog analytics-server 部署环境变量模板
#
# 用法：复制为同目录 .env 并填入真实值（.env 不入库）：
#   cp env.example .env
#   vim .env
# run.sh 启动时会自动加载 .env。
#
# 敏感值通过环境变量注入 configs/config.yaml 中的 ${VAR} 占位符，密钥不写入配置文件。
#
# 时区（phase: clklog-analytics-timezone-v1）：
# - 平台时区走 configs/config.yaml 的 `analytics.timezone`（IANA 名，缺省 Asia/Shanghai），不走环境变量。
# - 进程运行时统一 `TZ=UTC`（supervisord 配置已带）；业务日历经 src/modules/time/ 显式换算，
#   宿主系统时区差不再影响落库切日与 cron 触发。

# ClickHouse 密码（default / sa_readonly 用户共用）
CLICKHOUSE_PASSWORD=your_clickhouse_password

# MySQL（clklog_sa_meta 元数据库）密码
MYSQL_PASSWORD=your_mysql_password

# Prisma MySQL 连接串（user:password 已含密码）
# 生产用最小特权用户（只授权 clklog_sa_meta），勿用 root：
DATABASE_URL=mysql://clklog_sa_app:your_app_password@10.0.2.22:3306/clklog_sa_meta

# 告警邮件 / 短信（可选；不设则对应联系人类型不可用）
# ALERT_SMTP_HOST=
# ALERT_SMTP_PORT=465
# ALERT_SMTP_USER=
# ALERT_SMTP_PASS=
# ALERT_SMTP_FROM=
# ALERT_SMS_SECRET_ID=
# ALERT_SMS_SECRET_KEY=
# ALERT_SMS_SDK_APP_ID=
# ALERT_SMS_SIGN_NAME=
# ALERT_SMS_TEMPLATE_ID=

# 可选：覆盖监听端口（默认 3100，configs/config.yaml 中 server.port 优先）
# PORT=3100

# ---------------------------------------------------------------------------
# 数据清洗账号（定点删除，phase: clklog-data-management-v1.2）
#
# 账号从哪来：`apps/analytics-server/src/scripts/migrate-clickhouse.ts` 在发版时创建
#   ClickHouse 用户 `sa_cleanup`，仅授予 clklog_sa.* 的 SELECT / ALTER DELETE / ALTER UPDATE
#   （备份库 clklog_sa_bak 另给 INSERT/CREATE/DROP）。它**读不了社区版库 clklog**——
#   这条最小权限由数据库侧强制执行（实测：SELECT clklog.log_analysis 被 ACCESS_DENIED 拒绝）。
# 口令从哪来：本文件只是变量名模板；真实口令在**服务器上**，与 CLI 清洗脚本共用同一份：
#   /root/.clklog-cleanup.env（scripts/cleanup.sh 读它）
# 生产服务怎么拿到（两条路，任选其一，**都不需要 Puppet**）：
#   ① 推荐：应用直接读上面那份凭据文件（env 优先，文件兜底；路径可用 CLEANUP_ENV_FILE 覆盖）。
#      服务进程以 root 运行，读 600 的文件没问题；轮换时改这一份即可，重启服务生效。
#   ② 或注入环境变量：supervisor 程序配置
#      /etc/supervisord.d/clklog_analytics_server.ini 的 environment 行。
#      ⚠️ 注意：服务由 supervisor 直接拉起，**不走 server/run.sh**，把变量只放 server/.env 无效；
#      该 ini 由 Puppet 模板 modules/clklog/manifests/clklog_manager.pp 生成，
#      若走这条路必须回写模板（否则 puppet 一跑就覆盖）。
# 轮换：ALTER USER sa_cleanup IDENTIFIED WITH sha256_password BY '<新口令>'
#   → 同步更新 /root/.clklog-cleanup.env 与 supervisor ini 的 environment 行 → 重启服务。
#
# 未注入时：/ops/data-mgmt/delete/* 接口显式返回「清洗账号未配置」并拒绝执行，不回退高权账号。
# 口令至少 16 位（migrate 脚本按此校验）。
CLICKHOUSE_CLEANUP_USER=sa_cleanup
CLICKHOUSE_CLEANUP_PASSWORD=
# 二次确认令牌的签名密钥（不给则进程内随机生成 → 重启后旧 token 失效，可接受）
CLEANUP_CONFIRM_KEY=
