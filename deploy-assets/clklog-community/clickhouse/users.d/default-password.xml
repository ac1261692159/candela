<clickhouse>
    <!--
      口令不入库。
      default 用户由 scripts/standalone-test-env/deploy-middleware.sh 在目标机写入随机口令。
      sa_readonly 由 scripts/standalone-test-env/candela/init-db-clickhouse.sh 写入随机口令。
      本文件只保留已验证过的 profile / grants 形态，不要挂进正在运行的 ClickHouse。
    -->
    <profiles>
        <default>
            <max_partitions_per_insert_block>200</max_partitions_per_insert_block>
        </default>
        <!-- sa_readonly 专用 profile：readonly=2（允许客户端带设置如 enable_http_compression，仍禁写）
             + constraints 锁定不可降级到 0。
             注意：readonly=1 会拒绝 @clickhouse/client 每查询附带设置
             （"Cannot modify enable_http_compression in readonly mode"），必须用 2；
             用户级 <readonly> 设置不可靠，必须走 profile+constraints。 -->
        <sa_ro>
            <readonly>2</readonly>
            <constraints>
                <readonly>
                    <min>1</min>
                    <max>2</max>
                </readonly>
            </constraints>
        </sa_ro>
    </profiles>
    <users>
        <default>
            <password remove="1" />
            <access_management>1</access_management>
        </default>
        <!-- 分析平台只读账号（自定义 SQL / 对拍）。口令在部署时生成。
             users.xml 用户无法 GRANT，只能内嵌 grants。
             allow_databases 仅控制可见性，真正的授权靠 <grants>。 -->
        <sa_readonly>
            <profile>sa_ro</profile>
            <access_management>0</access_management>
            <grants>
                <query>GRANT SELECT ON clklog_sa.*</query>
                <query>GRANT SELECT ON clklog.*</query>
            </grants>
            <allow_databases>
                <database>clklog_sa</database>
                <database>clklog</database>
            </allow_databases>
        </sa_readonly>
    </users>
</clickhouse>
