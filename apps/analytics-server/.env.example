# ClkLog 分析平台后端 - 本地开发环境变量示例
# 复制为 .env 后填入真实值；.env 已加入 .gitignore，切勿提交。
# 此文件仅含占位符，真实密钥请填写到本地 .env。

# ClickHouse
CLICKHOUSE_PASSWORD=your_clickhouse_password

# MySQL / Prisma
MYSQL_PASSWORD=your_mysql_password
DATABASE_URL=mysql://root:your_mysql_password@localhost:13306/clklog_sa_meta

# Redis（本地无密码可留空）
# REDIS_PASSWORD=

# DeepSeek Harness AI 分析
# 模型供应商与密钥**不在环境变量里**：启动后在平台上按
# 「设置 → AI Workspace 管理 → 模型供应商」添加供应商并填写密钥。
# 这里没有 DEEPSEEK_API_KEY / AI_HARNESS_* 之类的开关；容量与权限预设见
# apps/analytics-server/config_dev.yaml 的 deepseek_harness 段。
# 若服务内部监听端口不是 3100，则显式覆盖
# CLKLOG_INTERNAL_API_BASE_URL=http://127.0.0.1:3100

# 告警邮件（可选；空则联系人里不可选邮件）
# ALERT_SMTP_HOST=
# ALERT_SMTP_PORT=465
# ALERT_SMTP_USER=
# ALERT_SMTP_PASS=
# ALERT_SMTP_FROM=
# ALERT_SMTP_SECURE=1

# 告警短信 腾讯云（可选；空则联系人里不可选短信）
# ALERT_SMS_SECRET_ID=
# ALERT_SMS_SECRET_KEY=
# ALERT_SMS_SDK_APP_ID=
# ALERT_SMS_SIGN_NAME=
# ALERT_SMS_TEMPLATE_ID=
# ALERT_SMS_REGION=ap-guangzhou
